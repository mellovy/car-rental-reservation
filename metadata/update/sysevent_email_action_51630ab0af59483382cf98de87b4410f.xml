        <message_html><![CDATA[<div style="font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333333;max-width:600px;">
  <div style="background-color:#1f4e79;color:#ffffff;padding:14px 20px;">
    <h2 style="margin:0;font-size:18px;color:#ffffff;">Your reserved car has changed</h2>
  </div>
  <div style="padding:20px;border:1px solid #dddddd;border-top:none;">
    <p style="margin:0 0 16px;">Hello,</p>
    <p style="margin:0 0 16px;">We have had to change the car assigned to your rental booking. Your rental dates have not changed - only the vehicle.</p>

    <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:14px;">
      <tr>
        <td style="padding:8px;border:1px solid #dddddd;background-color:#f5f5f5;width:35%;"><b>Your new car</b></td>
        <td style="padding:8px;border:1px solid #dddddd;">${car}</td>
      </tr>
      <tr>
        <td style="padding:8px;border:1px solid #dddddd;background-color:#f5f5f5;"><b>Rental from</b></td>
        <td style="padding:8px;border:1px solid #dddddd;">${start_date}</td>
      </tr>
      <tr>
        <td style="padding:8px;border:1px solid #dddddd;background-color:#f5f5f5;"><b>Rental until</b></td>
        <td style="padding:8px;border:1px solid #dddddd;">${end_date}</td>
      </tr>
      <tr>
        <td style="padding:8px;border:1px solid #dddddd;background-color:#f5f5f5;"><b>Rental duration</b></td>
        <td style="padding:8px;border:1px solid #dddddd;">${rental_duration}</td>
      </tr>
      <tr>
        <td style="padding:8px;border:1px solid #dddddd;background-color:#f5f5f5;"><b>Driver</b></td>
        <td style="padding:8px;border:1px solid #dddddd;">${driver_name}</td>
      </tr>
      <tr>
        <td style="padding:8px;border:1px solid #dddddd;background-color:#f5f5f5;"><b>Booking status</b></td>
        <td style="padding:8px;border:1px solid #dddddd;">${state}</td>
      </tr>
    </table>

    <p style="margin:20px 0 0;">If this change does not work for you, please contact the rental desk and we will do our best to find an alternative.</p>
    <p style="margin:16px 0 0;">Thank you for renting with us.</p>
  </div>
  <p style="margin:16px 0 0;font-size:12px;color:#888888;">This is an automated message. Please do not reply.</p>
</div>
<!-- Puts the receptionist group in CC. Renders as nothing - see the CC note above. -->
${mail_script:Car Rental - CC Receptionists}]]></message_html>
