        <script><![CDATA[   (function() {
     data.cars = [];
     var gr = new GlideRecord('x_..._car');
     gr.addQuery('available', true);
     gr.query();
     while (gr.next()) {
       data.cars.push({
         name: gr.getValue('name'),
         type: gr.getDisplayValue('type'),
         seats: gr.getValue('seating_capacity'),
         rent: gr.getDisplayValue('rent')
       });
     }
   })();]]></script>
